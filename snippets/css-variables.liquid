{%- comment -%}
  Self-hosted fonts + design tokens from theme settings.
  Fallback faces are metric-adjusted so the swap to Archivo does not shift layout.
{%- endcomment -%}
{%- liquid
  assign heading_scale = settings.heading_scale | divided_by: 100.0
  assign heading_tracking = settings.heading_tracking | divided_by: 100.0
  case settings.card_ratio
    when 'tall'
      assign card_ratio = '3 / 4'
    when 'square'
      assign card_ratio = '1 / 1'
    else
      assign card_ratio = '4 / 5'
  endcase
-%}
<style>
  @font-face {
    font-family: 'Archivo Black';
    src: url('{{ 'archivo-black-latin.woff2' | asset_url }}') format('woff2');
    font-weight: 400 900;
    font-style: normal;
    font-display: swap;
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }
  @font-face {
    font-family: 'Archivo';
    src: url('{{ 'archivo-latin-wght.woff2' | asset_url }}') format('woff2-variations'),
      url('{{ 'archivo-latin-wght.woff2' | asset_url }}') format('woff2');
    font-weight: 100 900;
    font-style: normal;
    font-display: swap;
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }
  @font-face {
    font-family: 'Archivo Black Fallback';
    src: local('Arial Black'), local('Arial Bold'), local('Helvetica Neue Bold'), local('Arial');
    size-adjust: 96%;
    ascent-override: 90%;
    descent-override: 22%;
    line-gap-override: 0%;
  }
  @font-face {
    font-family: 'Archivo Fallback';
    src: local('Arial'), local('Helvetica Neue'), local('Helvetica');
    size-adjust: 101%;
    ascent-override: 88%;
    descent-override: 21%;
    line-gap-override: 0%;
  }

  :root {
    --c-black: {{ settings.color_black }};
    --c-bone: {{ settings.color_bone }};
    --c-white: {{ settings.color_white }};
    --c-grey: {{ settings.color_grey }};
    --c-accent: {{ settings.color_accent }};
    --c-black-rgb: {{ settings.color_black.red }}, {{ settings.color_black.green }}, {{ settings.color_black.blue }};
    --c-bone-rgb: {{ settings.color_bone.red }}, {{ settings.color_bone.green }}, {{ settings.color_bone.blue }};
    --c-accent-rgb: {{ settings.color_accent.red }}, {{ settings.color_accent.green }}, {{ settings.color_accent.blue }};

    --font-display: 'Archivo Black', 'Archivo Black Fallback', 'Arial Black', sans-serif;
    --font-body: 'Archivo', 'Archivo Fallback', Arial, sans-serif;
    --heading-scale: {{ heading_scale }};
    --heading-tracking: {{ heading_tracking }}em;

    --logo-w: {{ settings.logo_width }}px;
    --logo-w-mobile: {{ settings.logo_width_mobile }}px;
    --card-ratio: {{ card_ratio }};
    --grain-opacity: {{ settings.grain_opacity | divided_by: 100.0 }};
  }
</style>
