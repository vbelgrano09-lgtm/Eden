{%- doc -%}
  The EDEN logo (EDEN with the crossed nails over the D), white on transparent,
  self-hosted in assets/. Used when no logo image is uploaded in Theme settings,
  and always by the intro loader.

  @param {boolean} [animated] - Adds the loader reveal hooks.
  @param {string} [class] - Extra classes for the <img>.
  @param {boolean} [decorative] - Empty alt (when the name is announced elsewhere).
  @param {string} [sizes] - `sizes` attribute, default 140px.
  @param {boolean} [eager] - Load eagerly (header, loader).
{%- enddoc -%}
{%- liquid
  assign logo_alt = shop.name | escape
  if decorative
    assign logo_alt = ''
  endif
  assign logo_sizes = sizes | default: '140px'
  assign logo_loading = 'lazy'
  if eager
    assign logo_loading = 'eager'
  endif
-%}
<img
  class="logo-eden{% if animated %} logo-eden--animated{% endif %}{% if class != blank %} {{ class }}{% endif %}"
  src="{{ 'eden-logo-480.webp' | asset_url }}"
  srcset="{{ 'eden-logo-480.webp' | asset_url }} 480w, {{ 'eden-logo-1000.webp' | asset_url }} 1000w"
  sizes="{{ logo_sizes }}"
  width="480"
  height="224"
  alt="{{ logo_alt }}"
  loading="{{ logo_loading }}"
  decoding="async"
>
