{%- liquid
  assign same_as = ''
  if settings.social_instagram != blank
    assign same_as = same_as | append: settings.social_instagram | append: '|'
  endif
  if settings.social_tiktok != blank
    assign same_as = same_as | append: settings.social_tiktok | append: '|'
  endif
  if settings.social_youtube != blank
    assign same_as = same_as | append: settings.social_youtube | append: '|'
  endif
  if settings.social_x != blank
    assign same_as = same_as | append: settings.social_x | append: '|'
  endif
  if settings.social_pinterest != blank
    assign same_as = same_as | append: settings.social_pinterest | append: '|'
  endif
  assign same_as = same_as | split: '|'
-%}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Organization",
        "name": {{ shop.name | json }},
        "url": {{ request.origin | append: routes.root_url | json }}
        {%- if settings.logo != blank -%}
          ,"logo": {{ settings.logo | image_url: width: 600 | prepend: 'https:' | json }}
        {%- endif -%}
        {%- if same_as.size > 0 -%}
          ,"sameAs": {{ same_as | json }}
        {%- endif -%}
      },
      {
        "@type": "WebSite",
        "name": {{ shop.name | json }},
        "url": {{ request.origin | append: routes.root_url | json }},
        "potentialAction": {
          "@type": "SearchAction",
          "target": {{ request.origin | append: routes.search_url | append: '?q={search_term_string}' | json }},
          "query-input": "required name=search_term_string"
        }
      }
    ]
  }
</script>
