{%- doc -%}
  Address form fields shared by "add" and "edit" address forms.

  @param {object} form - The customer_address form object.
  @param {string} prefix - Unique id suffix.
  @param {string} countries - Country option tags.
{%- enddoc -%}
<div class="contact__row">
  <div class="field">
    <label class="field__label label" for="AddressFirstName{{ prefix }}">{{ 'customer.fields.first_name' | t }}</label>
    <input class="input" id="AddressFirstName{{ prefix }}" type="text" name="address[first_name]" value="{{ form.first_name }}" autocomplete="given-name">
  </div>
  <div class="field">
    <label class="field__label label" for="AddressLastName{{ prefix }}">{{ 'customer.fields.last_name' | t }}</label>
    <input class="input" id="AddressLastName{{ prefix }}" type="text" name="address[last_name]" value="{{ form.last_name }}" autocomplete="family-name">
  </div>
</div>
<div class="field">
  <label class="field__label label" for="AddressCompany{{ prefix }}">{{ 'customer.fields.company' | t }}</label>
  <input class="input" id="AddressCompany{{ prefix }}" type="text" name="address[company]" value="{{ form.company }}" autocomplete="organization">
</div>
<div class="field">
  <label class="field__label label" for="AddressAddress1{{ prefix }}">{{ 'customer.fields.address1' | t }}</label>
  <input class="input" id="AddressAddress1{{ prefix }}" type="text" name="address[address1]" value="{{ form.address1 }}" autocomplete="address-line1">
</div>
<div class="field">
  <label class="field__label label" for="AddressAddress2{{ prefix }}">{{ 'customer.fields.address2' | t }}</label>
  <input class="input" id="AddressAddress2{{ prefix }}" type="text" name="address[address2]" value="{{ form.address2 }}" autocomplete="address-line2">
</div>
<div class="contact__row">
  <div class="field">
    <label class="field__label label" for="AddressCity{{ prefix }}">{{ 'customer.fields.city' | t }}</label>
    <input class="input" id="AddressCity{{ prefix }}" type="text" name="address[city]" value="{{ form.city }}" autocomplete="address-level2">
  </div>
  <div class="field">
    <label class="field__label label" for="AddressZip{{ prefix }}">{{ 'customer.fields.zip' | t }}</label>
    <input class="input" id="AddressZip{{ prefix }}" type="text" name="address[zip]" value="{{ form.zip }}" autocomplete="postal-code" autocapitalize="characters">
  </div>
</div>
<div class="contact__row">
  <div class="field">
    <label class="field__label label" for="AddressCountry{{ prefix }}">{{ 'customer.fields.country' | t }}</label>
    <div class="select-wrap">
      <select
        class="select"
        id="AddressCountry{{ prefix }}"
        name="address[country]"
        data-address-country="{{ prefix }}"
        data-default="{{ form.country }}"
        autocomplete="country"
      >
        {{ countries }}
      </select>
      {%- render 'icon', icon: 'chevron' -%}
    </div>
  </div>
  <div class="field" id="AddressProvinceWrap{{ prefix }}">
    <label class="field__label label" for="AddressProvince{{ prefix }}">{{ 'customer.fields.province' | t }}</label>
    <div class="select-wrap">
      <select
        class="select"
        id="AddressProvince{{ prefix }}"
        name="address[province]"
        data-default="{{ form.province }}"
        autocomplete="address-level1"
      ></select>
      {%- render 'icon', icon: 'chevron' -%}
    </div>
  </div>
</div>
<div class="field">
  <label class="field__label label" for="AddressPhone{{ prefix }}">{{ 'customer.fields.phone' | t }}</label>
  <input class="input" id="AddressPhone{{ prefix }}" type="tel" name="address[phone]" value="{{ form.phone }}" autocomplete="tel">
</div>
<label class="checkbox">
  {{ form.set_as_default_checkbox }}
  <span>{{ 'customer.addresses.set_default' | t }}</span>
</label>
