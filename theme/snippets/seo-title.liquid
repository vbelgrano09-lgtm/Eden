{%- comment -%}
  Clean SEO titles: "Page — Shop", with search terms, tags and pagination when relevant.
{%- endcomment -%}
{%- capture seo_title -%}
  {%- if request.page_type == 'search' and search.terms != blank -%}
    {{- 'general.meta.search_results' | t: terms: search.terms -}}
  {%- else -%}
    {{- page_title -}}
  {%- endif -%}
  {%- if current_tags -%}
    {%- assign tags_joined = current_tags | join: ', ' -%}
    {{- ' — ' -}}{{- 'general.meta.tagged' | t: tags: tags_joined -}}
  {%- endif -%}
  {%- if current_page != 1 -%}
    {{- ' — ' -}}{{- 'general.meta.page' | t: page: current_page -}}
  {%- endif -%}
  {%- unless page_title contains shop.name -%}
    {{- ' — ' -}}{{- shop.name -}}
  {%- endunless -%}
{%- endcapture -%}
<title>{{ seo_title | strip_newlines | strip }}</title>
{%- if page_description != blank -%}
  <meta name="description" content="{{ page_description | escape }}">
{%- endif -%}
