{%- comment -%}
  Intro loader. Only visible when <html> has .has-loader, which the <head> script sets
  once per browser session (never with reduced motion, never in the theme editor).
  The timeline is pure CSS so it never waits on deferred JS:
    0.00–0.70s  two nails draw themselves, side by side
    0.55–0.95s  they swing and cross over the D
    0.70–1.15s  E · D · E · N fade in
    1.10–1.30s  a seam of light opens across the middle
    1.30–1.80s  the screen splits open
  Skip: button, Escape, click, wheel or touch.
{%- endcomment -%}
<div class="loader" id="EdenLoader">
  <div class="loader__panel loader__panel--top"></div>
  <div class="loader__panel loader__panel--bottom"></div>
  <span class="loader__seam"></span>
  <div class="loader__mark">
    {%- render 'logo-eden', animated: true, decorative: true -%}
  </div>
  <button type="button" class="loader__skip label" data-loader-skip>
    {{- 'general.loader.skip' | t -}}
  </button>
</div>
<script>
  (function () {
    var root = document.documentElement;
    var el = document.getElementById('EdenLoader');
    if (!el) return;
    if (!root.classList.contains('has-loader')) {
      el.parentNode.removeChild(el);
      return;
    }
    var done = false;
    function finish() {
      if (done) return;
      done = true;
      root.classList.remove('has-loader');
      root.classList.add('loader-done');
      if (el.parentNode) el.parentNode.removeChild(el);
      document.dispatchEvent(new CustomEvent('eden:loader:done'));
    }
    function skip() {
      if (done || el.classList.contains('is-skipping')) return;
      el.classList.add('is-skipping');
      root.classList.add('intro-skipped');
      setTimeout(finish, 420);
    }
    setTimeout(finish, 1800);
    el.addEventListener('click', skip);
    window.addEventListener('wheel', skip, { passive: true, once: true });
    window.addEventListener('touchstart', skip, { passive: true, once: true });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') skip();
    });
  })();
</script>
