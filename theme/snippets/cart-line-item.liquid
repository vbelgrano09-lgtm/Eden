{%- doc -%}
  One cart line (drawer + cart page). Quantity and remove are handled by <cart-items>.

  @param {line_item} item - The cart line.
  @param {string} id_prefix - Unique id prefix (drawer vs page).
  @param {boolean} [large] - Bigger image on the cart page.
{%- enddoc -%}
{%- assign title_escaped = item.product.title | escape -%}
<div
  class="line-item"
  data-line-key="{{ item.key }}"
  data-removed-text="{{ 'cart.removed' | t: title: title_escaped }}"
>
  <a class="line-item__media" href="{{ item.url }}" tabindex="-1" aria-hidden="true">
    {%- if item.image -%}
      {%- if large -%}
        {{ item.image | image_url: width: 480 | image_tag: loading: 'lazy', widths: '160, 240, 320, 480', sizes: '(min-width: 750px) 160px, 96px', alt: '' }}
      {%- else -%}
        {{ item.image | image_url: width: 240 | image_tag: loading: 'lazy', widths: '120, 192, 240', sizes: '96px', alt: '' }}
      {%- endif -%}
    {%- endif -%}
  </a>
  <div class="line-item__info">
    <div class="line-item__top">
      <a class="line-item__title link" href="{{ item.url }}">{{ item.product.title }}</a>
      <span class="price">
        {%- if item.original_line_price != item.final_line_price -%}
          <s class="price__compare">{{ item.original_line_price | money }}</s>
        {%- endif -%}
        {{ item.final_line_price | money }}
      </span>
    </div>

    {%- unless item.product.has_only_default_variant -%}
      <p class="line-item__options">
        {%- for option in item.options_with_values -%}
          {{ option.name }}: {{ option.value }}
          {%- unless forloop.last %} · {% endunless -%}
        {%- endfor -%}
      </p>
    {%- endunless -%}

    {%- for property in item.properties -%}
      {%- assign first_char = property.first | slice: 0 -%}
      {%- if property.last != blank and first_char != '_' -%}
        <p class="line-item__options">{{ property.first }}: {{ property.last }}</p>
      {%- endif -%}
    {%- endfor -%}

    {%- if item.selling_plan_allocation -%}
      <p class="line-item__options">{{ item.selling_plan_allocation.selling_plan.name }}</p>
    {%- endif -%}

    {%- for discount in item.line_level_discount_allocations -%}
      <p class="line-item__note">{{ discount.discount_application.title }} (−{{ discount.amount | money }})</p>
    {%- endfor -%}

    <p class="line-item__note">{{ 'products.product.made_to_order_short' | t }}</p>

    <div class="line-item__actions">
      <div class="qty">
        <button
          class="qty__btn"
          type="button"
          data-qty-change="-1"
          aria-label="{{ 'cart.decrease' | t: title: title_escaped }}"
        >
          {%- render 'icon', icon: 'minus' -%}
        </button>
        <label class="visually-hidden" for="{{ id_prefix }}-qty-{{ item.index }}">
          {{- 'cart.quantity_for' | t: title: title_escaped -}}
        </label>
        <input
          class="qty__input"
          id="{{ id_prefix }}-qty-{{ item.index }}"
          name="updates[]"
          type="number"
          inputmode="numeric"
          min="0"
          value="{{ item.quantity }}"
          data-qty-input
        >
        <button
          class="qty__btn"
          type="button"
          data-qty-change="1"
          aria-label="{{ 'cart.increase' | t: title: title_escaped }}"
        >
          {%- render 'icon', icon: 'plus' -%}
        </button>
      </div>
      <a class="line-item__remove" href="{{ item.url_to_remove }}" data-line-remove>
        {{- 'cart.remove' | t -}}
        <span class="visually-hidden"> {{ item.product.title }}</span>
      </a>
    </div>
    <p class="form-error" data-line-error role="alert" hidden></p>
  </div>
</div>
