{%- assign s = section.settings -%}
<section class="section scheme-{{ s.scheme }}">
  <div class="page-width faq">
    <div class="faq__aside">
      {%- if s.eyebrow != blank -%}
        <p class="label muted section-head__eyebrow">{{ s.eyebrow }}</p>
      {%- endif -%}
      <h2 class="h2" data-split="chars">{{ s.title }}</h2>
      {%- if s.text != blank -%}
        <div class="rte muted" style="margin-top: 24px">{{ s.text }}</div>
      {%- endif -%}
    </div>
    <div class="faq__list">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'group' -%}
            <h3 class="faq__group-title label muted" {{ block.shopify_attributes }}>{{ block.settings.heading }}</h3>
          {%- when 'question' -%}
            <details class="accordion__item" {{ block.shopify_attributes }}>
              <summary class="accordion__summary">
                <span class="h4">{{ block.settings.question }}</span>
                <span class="accordion__icon" aria-hidden="true"></span>
              </summary>
              <div class="accordion__content rte">{{ block.settings.answer }}</div>
            </details>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{%- assign questions = section.blocks | where: 'type', 'question' -%}
{%- if questions.size > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for block in questions -%}
          {
            "@type": "Question",
            "name": {{ block.settings.question | json }},
            "acceptedAnswer": {
              "@type": "Answer",
              "text": {{ block.settings.answer | json }}
            }
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "FAQ",
  "tag": "div",
  "class": "section-faq",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Help"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Questions"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Can't find it here? Write to us. Two founders read every message.</p>"
    },
    {
      "type": "select",
      "id": "scheme",
      "label": "Color scheme",
      "options": [
        { "value": "dark", "label": "Black" },
        { "value": "bone", "label": "Bone" }
      ],
      "default": "dark"
    }
  ],
  "blocks": [
    {
      "type": "group",
      "name": "Group heading",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Orders"
        }
      ]
    },
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "What does made to order mean?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Your piece is produced after you order it, just for you. No overstock, no waste.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        { "type": "group" },
        { "type": "question" }
      ]
    }
  ]
}
{% endschema %}
