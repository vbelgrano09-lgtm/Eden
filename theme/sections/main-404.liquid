{%- assign lines = section.settings.title | newline_to_br | split: '<br />' -%}
<section class="not-found section-grain">
  <span class="not-found__code" aria-hidden="true">404</span>
  <div class="not-found__inner">
    <p class="label muted">{{ 'general.404.label' | t }}</p>
    <h1 class="not-found__title">
      {%- for line in lines -%}
        {{ line | strip }}
        {%- unless forloop.last %}<br>{% endunless -%}
      {%- endfor -%}
    </h1>
    {%- if section.settings.text != blank -%}
      <p class="body-lg muted">{{ section.settings.text }}</p>
    {%- endif -%}
    <div class="hero__ctas">
      <span class="magnetic" data-magnetic>
        <a class="btn btn--bone btn--lg" href="{{ routes.root_url }}">
          <span class="btn__label">{{ section.settings.button }} {% render 'icon', icon: 'arrow' %}</span>
        </a>
      </span>
      <a class="btn btn--lg" href="{{ routes.all_products_collection_url }}">
        <span class="btn__label">{{ section.settings.button_2 }}</span>
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "404",
  "tag": "section",
  "class": "section-404",
  "settings": [
    {
      "type": "textarea",
      "id": "title",
      "label": "Title",
      "default": "Lost?\nSo were we."
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Come home."
    },
    {
      "type": "text",
      "id": "button",
      "label": "Button",
      "default": "Come home"
    },
    {
      "type": "text",
      "id": "button_2",
      "label": "Second button",
      "default": "Shop the chapter"
    }
  ]
}
{% endschema %}
