<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_black }}">
    <meta name="color-scheme" content="dark">
    <link rel="canonical" href="{{ canonical_url }}">
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
    {%- endif -%}

    {%- render 'seo-title' -%}
    {%- render 'meta-tags' -%}

    {{ 'archivo-black-latin.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
    {%- render 'css-variables' -%}
    {%- render 'head-bootstrap', loader_on: false -%}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'theme.js' | asset_url }}" defer></script>

    {{ content_for_header }}
  </head>

  <body class="template-password">
    <a class="skip-link label" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>
    <main id="MainContent" class="main" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>
    {%- if settings.grain_enable -%}
      <div class="grain" aria-hidden="true"></div>
    {%- endif -%}
    <div class="visually-hidden" aria-live="polite" role="status" data-live-region></div>
  </body>
</html>
