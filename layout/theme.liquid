<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_black }}">
    <meta name="color-scheme" content="dark">
    <link rel="canonical" href="{{ canonical_url }}">
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
      <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180, height: 180 }}">
    {%- endif -%}

    {%- render 'seo-title' -%}
    {%- render 'meta-tags' -%}

    {{ 'archivo-black-latin.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
    {{ 'archivo-latin-wght.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}

    {%- render 'css-variables' -%}

    {%- liquid
      assign motion = settings.motion_enable
      assign loader_on = false
      if motion and settings.loader_enable
        if settings.loader_scope == 'all' or template.name == 'index'
          assign loader_on = true
        endif
      endif
    -%}

    {%- render 'head-bootstrap', loader_on: loader_on -%}

    {{ 'base.css' | asset_url | stylesheet_tag }}

    {%- if motion and settings.page_transitions and request.design_mode == false -%}
      <link rel="expect" href="#MainContent" blocking="render">
      <style>
        @media (prefers-reduced-motion: no-preference) {
          @view-transition {
            navigation: auto;
          }
        }
      </style>
    {%- endif -%}

    <script src="{{ 'theme.js' | asset_url }}" defer></script>
    {%- if motion -%}
      <script src="{{ 'gsap.min.js' | asset_url }}" defer></script>
      <script src="{{ 'ScrollTrigger.min.js' | asset_url }}" defer></script>
      {%- if settings.split_text -%}
        <script src="{{ 'SplitText.min.js' | asset_url }}" defer></script>
      {%- endif -%}
      {%- if settings.smooth_scroll -%}
        <script src="{{ 'lenis.min.js' | asset_url }}" defer></script>
      {%- endif -%}
      <script src="{{ 'motion.js' | asset_url }}" defer></script>
    {%- endif -%}

    {{ content_for_header }}
  </head>

  <body class="template-{{ template | replace: '/', '-' | replace: '.', '--' }}{% if settings.image_lighting %} has-lighting{% endif %}">
    <a class="skip-link label" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>

    {%- if loader_on -%}
      {%- render 'loader' -%}
    {%- endif -%}

    {% sections 'header-group' %}

    <main id="MainContent" class="main" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% section 'cart-drawer' %}

    <div class="overlay-shade" data-shade hidden></div>

    {%- if motion and settings.page_transitions -%}
      <div class="pt-curtain" aria-hidden="true"><span class="pt-curtain__mark">{% render 'icon', icon: 'nails' %}</span></div>
    {%- endif -%}

    {%- if motion and settings.cursor_enable -%}
      <div class="cursor{% if settings.cursor_hide_native %} cursor--replace{% endif %}" aria-hidden="true">
        <span class="cursor__dot"></span>
        <span class="cursor__label"></span>
      </div>
    {%- endif -%}

    {%- if settings.grain_enable -%}
      <div class="grain" aria-hidden="true"></div>
    {%- endif -%}

    <div class="visually-hidden" aria-live="polite" role="status" data-live-region></div>

    {%- if request.page_type == 'index' -%}
      {%- render 'json-ld-organization' -%}
    {%- endif -%}
  </body>
</html>
