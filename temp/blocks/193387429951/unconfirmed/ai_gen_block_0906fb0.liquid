{% doc %}
  @prompt
    generame el catalogo que no esta
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-catalog-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: 36px 0;
    color: #F4F1EA;
    background: #0A0A0A;
  }

  .ai-catalog-{{ ai_gen_id }} .ai-catalog__inner-{{ ai_gen_id }} {
    width: 100%;
  }

  .ai-catalog-{{ ai_gen_id }} .ai-catalog__heading-{{ ai_gen_id }} {
    margin: 0 0 26px;
    color: #F4F1EA;
    font-size: clamp(28px, 5vw, 54px);
    line-height: 0.98;
    letter-spacing: -0.04em;
    text-transform: uppercase;
  }

  .ai-catalog-{{ ai_gen_id }} .ai-catalog__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, minmax(0, 1fr));
    gap: 28px 14px;
  }

  .ai-catalog-{{ ai_gen_id }} .ai-catalog__card-{{ ai_gen_id }} {
    min-width: 0;
    color: #F4F1EA;
    text-decoration: none;
  }

  .ai-catalog-{{ ai_gen_id }} .ai-catalog__media-{{ ai_gen_id }} {
    display: block;
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    background: #1C1C1C;
  }

  .ai-catalog-{{ ai_gen_id }} .ai-catalog__media-{{ ai_gen_id }} img,
  .ai-catalog-{{ ai_gen_id }} .ai-catalog__media-{{ ai_gen_id }} svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-catalog-{{ ai_gen_id }} .ai-catalog__placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background: #1C1C1C;
  }

  .ai-catalog-{{ ai_gen_id }} .ai-catalog__placeholder-{{ ai_gen_id }} svg {
    color: #8C8C88;
  }

  .ai-catalog-{{ ai_gen_id }} .ai-catalog__details-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 10px;
    padding-top: 11px;
  }

  .ai-catalog-{{ ai_gen_id }} .ai-catalog__title-{{ ai_gen_id }} {
    margin: 0;
    color: #F4F1EA;
    font-size: 13px;
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .ai-catalog-{{ ai_gen_id }} .ai-catalog__price-{{ ai_gen_id }} {
    flex: 0 0 auto;
    color: #F4F1EA;
    font-size: 13px;
    line-height: 1.35;
    white-space: nowrap;
  }

  .ai-catalog-{{ ai_gen_id }} .ai-catalog__empty-{{ ai_gen_id }} {
    padding: 32px 20px;
    border: 1px solid #8C8C88;
    color: #F4F1EA;
    font-size: 14px;
    text-align: center;
  }

  .ai-catalog-{{ ai_gen_id }} a:focus-visible {
    outline: 2px solid #F4F1EA;
    outline-offset: 4px;
  }

  @media screen and (max-width: 749px) {
    .ai-catalog-{{ ai_gen_id }} {
      padding: 26px 0;
    }
    .ai-catalog-{{ ai_gen_id }} .ai-catalog__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 22px 10px;
    }
  }
{% endstyle %}

<div class="ai-catalog-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-catalog__inner-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-catalog__heading-{{ ai_gen_id }}">{{ block.settings.heading | escape }}</h2>
    {% endif %}

    {% if block.settings.collection != blank and block.settings.collection.products.size > 0 %}
      <div class="ai-catalog__grid-{{ ai_gen_id }}">
        {% for product in block.settings.collection.products limit: block.settings.products_to_show %}
          <a class="ai-catalog__card-{{ ai_gen_id }}" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
            <span class="ai-catalog__media-{{ ai_gen_id }}">
              {% if product.featured_image %}
                <img
                  src="{{ product.featured_image | image_url: width: 900 }}"
                  alt="{{ product.featured_image.alt | default: product.title | escape }}"
                  loading="lazy"
                  width="{{ product.featured_image.width }}"
                  height="{{ product.featured_image.height }}"
                >
              {% else %}
                <span class="ai-catalog__placeholder-{{ ai_gen_id }}">{{ 'product-apparel-1' | placeholder_svg_tag }}</span>
              {% endif %}
            </span>
            <span class="ai-catalog__details-{{ ai_gen_id }}">
              <span class="ai-catalog__title-{{ ai_gen_id }}">{{ product.title | escape }}</span>
              <span class="ai-catalog__price-{{ ai_gen_id }}">{{ product.price | money }}</span>
            </span>
          </a>
        {% endfor %}
      </div>
    {% else %}
      <div class="ai-catalog__empty-{{ ai_gen_id }}">
        {% if block.settings.collection == blank %}
          Elegí una colección en la configuración del bloque para mostrar el catálogo.
        {% else %}
          Esta colección todavía no tiene productos disponibles.
        {% endif %}
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Catálogo de productos",
  "settings": [
    {
      "type": "header",
      "content": "Contenido"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Catálogo"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Colección"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Productos a mostrar",
      "min": 4,
      "max": 24,
      "step": 2,
      "default": 12
    },
    {
      "type": "header",
      "content": "Diseño"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Ancho en escritorio",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Columnas en escritorio",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "3"
    }
  ],
  "presets": [
    {
      "name": "Catálogo de productos"
    }
  ],
  "tag": null,
  "class": "ai-catalog-block"
}
{% endschema %}