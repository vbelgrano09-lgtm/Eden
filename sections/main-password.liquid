{%- liquid
  assign s = section.settings
  capture iso
    render 'countdown-iso', date: s.date, offset: s.offset
  endcapture
  assign lines = s.title | newline_to_br | split: '<br />'
-%}
<div class="password section-grain">
  <header class="password__top">
    <div class="password__logo">
      {%- if settings.logo != blank -%}
        {%- assign logo_alt = settings.logo.alt | default: shop.name -%}
        {{ settings.logo | image_url: width: 600 | image_tag: widths: '200, 400, 600', sizes: '180px', alt: logo_alt }}
      {%- else -%}
        {%- render 'logo-eden', eager: true, sizes: '180px' -%}
      {%- endif -%}
    </div>
    <button class="text-btn label link link--static" type="button" data-modal-open="PasswordModal">
      {{- 'password.enter' | t -}}
    </button>
  </header>

  <div class="password__body page-width">
    {%- if s.eyebrow != blank -%}
      <p class="label muted">{{ s.eyebrow }}</p>
    {%- endif -%}
    <h1 class="password__title h-display">
      {%- for line in lines -%}
        <span class="hero__line"><span class="hero__line-inner" style="--i: {{ forloop.index0 }}">{{ line | strip }}</span></span>
      {%- endfor -%}
    </h1>
    {%- if shop.password_message != blank -%}
      <p class="body-lg muted password__message">{{ shop.password_message }}</p>
    {%- elsif s.text != blank -%}
      <p class="body-lg muted password__message">{{ s.text }}</p>
    {%- endif -%}

    {%- if s.date != blank -%}
      {%- render 'countdown',
        iso: iso,
        label: s.countdown_label,
        live_title: s.live_title,
        readable_date: s.date
      -%}
    {%- endif -%}

    <div class="password__signup">
      <p class="h3">{{ s.newsletter_title }}</p>
      {%- render 'newsletter-form', form_id: 'PasswordNewsletter', button: s.newsletter_button -%}
    </div>
  </div>

  <footer class="password__foot label muted page-width">
    {%- render 'social-icons' -%}
    <p>{{ 'password.powered_by_html' | t: shopify: powered_by_link }}</p>
    <p><a class="link link--static" href="/admin">{{ 'password.admin' | t }}</a></p>
  </footer>
</div>

<dialog class="modal password__modal" id="PasswordModal" aria-labelledby="PasswordModalTitle">
  <div class="modal__head">
    <h2 class="h3" id="PasswordModalTitle">{{ 'password.enter' | t }}</h2>
    <button class="icon-btn" type="button" data-modal-close>
      <span class="visually-hidden">{{ 'general.close' | t }}</span>
      {%- render 'icon', icon: 'close' -%}
    </button>
  </div>
  <div class="modal__body">
    {%- form 'storefront_password', class: 'contact__form' -%}
      {%- if form.errors -%}
        <p class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</p>
        <script>
          document.addEventListener('DOMContentLoaded', function () {
            var dialog = document.getElementById('PasswordModal');
            if (dialog && dialog.showModal && !dialog.open) dialog.showModal();
          });
        </script>
      {%- endif -%}
      <div class="field">
        <label class="field__label label" for="StorefrontPassword">{{ 'password.password' | t }}</label>
        <input
          class="input"
          id="StorefrontPassword"
          type="password"
          name="password"
          autocomplete="current-password"
          required
          {% if form.errors %}
            aria-invalid="true" autofocus
          {% endif %}
        >
      </div>
      <button class="btn btn--bone" type="submit">{{ 'password.submit' | t }}</button>
    {%- endform -%}
  </div>
</dialog>

{% schema %}
{
  "name": "Coming soon",
  "tag": "section",
  "class": "section-password",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "EDEN — Faith over fear"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Title",
      "default": "Chapter 002\nis coming."
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text (used when the password message is empty)",
      "default": "Made to order. Shipped worldwide. Be ready."
    },
    {
      "type": "text",
      "id": "countdown_label",
      "label": "Countdown label",
      "default": "Doors open in"
    },
    {
      "type": "text",
      "id": "date",
      "label": "Opening date and time",
      "info": "Format: YYYY-MM-DD HH:MM (24h). Leave empty to hide the countdown.",
      "default": "2026-11-13 18:00"
    },
    {
      "type": "select",
      "id": "offset",
      "label": "Time zone",
      "options": [
        { "value": "-08:00", "label": "Los Angeles (PST, UTC−8)" },
        { "value": "-07:00", "label": "Los Angeles summer (PDT, UTC−7)" },
        { "value": "-06:00", "label": "Chicago (CST, UTC−6)" },
        { "value": "-05:00", "label": "New York / Toronto (EST, UTC−5)" },
        { "value": "-04:00", "label": "New York summer (EDT, UTC−4)" },
        { "value": "Z", "label": "London (GMT, UTC)" },
        { "value": "+01:00", "label": "London summer (BST, UTC+1)" },
        { "value": "+08:00", "label": "Perth (AWST, UTC+8)" },
        { "value": "+10:00", "label": "Sydney (AEST, UTC+10)" },
        { "value": "+11:00", "label": "Sydney summer (AEDT, UTC+11)" }
      ],
      "default": "-05:00"
    },
    {
      "type": "text",
      "id": "live_title",
      "label": "Title at zero",
      "default": "Live now"
    },
    {
      "type": "text",
      "id": "newsletter_title",
      "label": "Signup title",
      "default": "No discounts. Just drops."
    },
    {
      "type": "text",
      "id": "newsletter_button",
      "label": "Signup button",
      "default": "Notify me"
    }
  ]
}
{% endschema %}
