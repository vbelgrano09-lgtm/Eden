{%- assign s = section.settings -%}
<section class="section scheme-{{ s.scheme }}{% if s.grain %} section-grain{% endif %}">
  <div class="page-width">
    {%- if s.title != blank -%}
      <div class="section-head">
        <div>
          {%- if s.eyebrow != blank -%}
            <p class="label muted section-head__eyebrow">{{ s.eyebrow }}</p>
          {%- endif -%}
          <h2 class="h2" data-split="chars">{{ s.title }}</h2>
        </div>
      </div>
    {%- endif -%}
    <div class="columns" style="--cols: {{ s.columns }}">
      {%- for block in section.blocks -%}
        <div class="columns__item" data-reveal {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {%- assign col_alt = block.settings.image.alt | default: '' -%}
            <div class="columns__media media-lit">
              {{
                block.settings.image
                | image_url: width: 1200
                | image_tag: loading: 'lazy', widths: '360, 540, 720, 960, 1200', sizes: '(min-width: 990px) 31vw, (min-width: 750px) 46vw, 92vw', alt: col_alt
              }}
            </div>
          {%- endif -%}
          {%- if s.numbered -%}
            <p class="columns__num label">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</p>
          {%- endif -%}
          <h3 class="h3">{{ block.settings.title }}</h3>
          <div class="columns__text rte">{{ block.settings.text }}</div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Text columns",
  "tag": "div",
  "class": "section-columns",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "What we stand on"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Three things"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns on desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "numbered",
      "label": "Number the columns",
      "default": true
    },
    {
      "type": "select",
      "id": "scheme",
      "label": "Color scheme",
      "options": [
        { "value": "dark", "label": "Black" },
        { "value": "bone", "label": "Bone" }
      ],
      "default": "dark"
    },
    {
      "type": "checkbox",
      "id": "grain",
      "label": "Grain texture",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Worn, not preached"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Faith you can live in. No church clichés, no stock imagery. Just the line, the nails and the weight of a good hoodie.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Text columns",
      "blocks": [
        { "type": "column" },
        { "type": "column" },
        { "type": "column" }
      ]
    }
  ]
}
{% endschema %}
