{{ 'customer.css' | asset_url | stylesheet_tag }}
<div class="customer page-width page-width--narrow">
  <header class="page-head">
    <p class="label muted">{{ 'customer.eyebrow' | t }}</p>
    <h1 class="page-head__title">{{ 'customer.reset.title' | t }}</h1>
    <p class="muted">{{ 'customer.reset.text' | t }}</p>
  </header>
  {%- form 'reset_customer_password', class: 'customer__form' -%}
    {%- if form.errors -%}
      <div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>
    {%- endif -%}
    <div class="field">
      <label class="field__label label" for="ResetPassword">{{ 'customer.fields.password' | t }}</label>
      <input class="input" id="ResetPassword" type="password" name="customer[password]" autocomplete="new-password" required>
    </div>
    <div class="field">
      <label class="field__label label" for="ResetPasswordConfirm">{{ 'customer.fields.password_confirm' | t }}</label>
      <input class="input" id="ResetPasswordConfirm" type="password" name="customer[password_confirmation]" autocomplete="new-password" required>
    </div>
    <button class="btn btn--bone btn--full btn--lg" type="submit">{{ 'customer.reset.submit' | t }}</button>
  {%- endform -%}
</div>

{% schema %}
{
  "name": "Reset password",
  "tag": "section",
  "class": "section-customer"
}
{% endschema %}
